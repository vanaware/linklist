{
  "version": "0.1.16#mvef2odr",
  "description": "Link-in-bio static site generator (config.json -> static HTML).",
  "license": "MIT",
  "author": "Vanaware",
  "repository": {
    "type": "git",
    "url": "https://github.com/vanaware/linklist"
  },
  "workspace": [
    "./packages/core",
    "./packages/server"
  ],
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "esnext"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": 5,
  "vendor": true,
  "unstable": [
    "bundle"
  ],
  "exclude": [
    ".qwen/",
    ".vscode/",
    ".github/",
    "packages/server/build/",
    "vendor",
    "node_modules",
    "snapshots",
    "docs"
  ],
  "catalog": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": [
    "npm:esbuild@0.28.2"
  ],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "@vanaware/buildit": "jsr:@vanaware/buildit@^0.5.2",
    "@vanaware/linklist-core": "./packages/core/src/mod.ts"
  },
  "tasks": {
    "test": "deno test --no-check -P",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check:all": "deno task --members check && deno check scripts/**/*.ts",
    "fmt:check": "deno fmt --check",
    "lint:fix": "deno lint --fix",
    "tests": "deno task check:all && deno task lint && deno task fmt:check && deno task test",
    "dev": "deno task build && deno task --cwd packages/server dev",
    "serve": "deno task --cwd packages/server dev",
    "validate-config": "deno run -A scripts/validate.ts",
    "build": "deno run --allow-read --allow-write --allow-run scripts/esbuild.ts -n linklist",
    "build:deno": "deno run -A scripts/denobuild.ts -n linklist",
    "build:dist": "deno run -A scripts/esbuild.ts linklist-dist",
    "start": "deno task --cwd packages/server start",
    "export": "deno run --allow-env --allow-read --allow-write ./scripts/export.ts",
    "esbuild": "deno run --allow-env --allow-run --allow-read --allow-write ./scripts/esbuild.ts",
    "denobuild": "deno run --unstable-bundle -A ./scripts/denobuild.ts",
    "watch": "deno run -A ./scripts/watch.ts",
    "sanitize-version": "deno run -A ./scripts/sanitize-version.ts",
    "tag-version": "deno run -A ./scripts/tag-version.ts",
    "bump": "deno install --frozen=false && deno task esbuild noversion && deno task tag-version"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "ban-untagged-todo"
      ],
      "exclude": [
        "no-unused-vars"
      ]
    },
    "include": [
      "scripts/**/*.ts",
      "packages/**/src/**/*.{ts,tsx}",
      "packages/**/tests/**/*test.ts"
    ]
  },
  "test": {
    "permissions": {
      "read": true,
      "write": true,
      "net": true,
      "env": true,
      "sys": true,
      "run": true,
      "ffi": true,
      "import": true
    },
    "include": [
      "packages/**/tests/**/*test.ts"
    ],
    "exclude": [
      "packages/server/build/",
      "scripts/**/*.ts",
      "packages/**/src/**/*.{ts,tsx}"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "trailingCommas": "always",
    "json.trailingCommas": "never",
    "operatorPosition": "maintain",
    "jsx.bracketPosition": "sameLine",
    "jsx.forceNewLinesSurroundingContent": true,
    "jsx.multiLineParens": "always",
    "newLineKind": "lf",
    "include": [
      "scripts/**/*.ts",
      "packages/**/src/**/*.{ts,tsx}",
      "packages/**/tests/**/*test.ts"
    ],
    "exclude": [
      "packages/server/build/"
    ]
  }
}