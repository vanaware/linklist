{
  "name": "@vanaware/server",
  "description": "Local static file-server used to preview and test the built linklist site. Development aid only — never published.",
  "publish": false,
  "compilerOptions": {
    // Server is a pure Deno static file-server (no DOM, no UI deps).
    "lib": [
      "deno.window"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    // Package-exclusive deps only. `@std/path` is workspace-common and comes
    // from the root deno.jsonc import map.
    "@std/http": "jsr:@std/http@^1.1.4"
  },
  "tasks": {
    "test": "deno test --no-check --allow-env --allow-net --allow-read tests/**/*test.ts",
    "check": "deno check src/**/*.{ts,tsx}",
    "tests": "deno task check && deno task test",
    "start": "deno run --allow-read --allow-write --allow-env --allow-net --env-file ./src/main.ts",
    "dev": "deno run --allow-read --allow-write --allow-env --allow-net --env-file --watch ./src/main.ts",
    "clean": "deno clean && rm -rf ./build && mkdir -p ./build/dist"
  },
  "exports": "./src/main.ts",
  "exclude": [
    "./build/"
  ]
}
