{
  "name": "@vanaware/linklist",
  "version": "0.1.26#mvgwczni",
  "description": "Pure config schema, validator and static renderer for linklist.",
  "author": "Vanaware",
  "license": "MIT",
  "compilerOptions": {
    // Core runs in BOTH worlds: the browser bundle (entry.ts + components —
    // needs DOM) and the Deno CLI/tests (cli.ts — needs the Deno namespace).
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  "exports": {
    ".": "./src/mod.ts"
  },
  "imports": {
    // Package-exclusive deps only. `@std/path` is workspace-common and comes
    // from the root deno.jsonc import map.
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.5",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "arktype": "npm:arktype@^2.1.20",
    "preact": "npm:preact@10.25.4",
    "preact-render-to-string": "npm:preact-render-to-string@^6.5.13",
    "@preact/signals": "npm:@preact/signals@2.0.1",
    "htm/preact": "npm:htm@^3.1.1/preact",
    "mdast-util-from-markdown": "npm:mdast-util-from-markdown@^2.0.2",
    "mdast-util-gfm": "npm:mdast-util-gfm@^3.1.0",
    "micromark-extension-gfm": "npm:micromark-extension-gfm@^3.0.0"
  },
  "tasks": {
    "test": "deno test -P",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check src/**/*.ts tests/**/*.ts",
    "fmt:check": "deno fmt --check",
    "tests": "deno task check && deno task lint && deno task test"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "docs/**/*.md",
      "dist/linklist.min.js",
      "dist/linklist.min.js.map",
      "deno.jsonc",
      "public",
      "schema",
      "themes"
    ],
    "exclude": [
      "tests"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "ban-untagged-todo"
      ],
      "exclude": [
        "no-unused-vars"
      ]
    },
    "include": [
      "src/**/*.{ts,tsx}",
      "tests/**/*test.ts"
    ]
  },
  "test": {
    "permissions": {
      "read": true,
      "write": true,
      "net": true,
      "env": true,
      "sys": true,
      "run": true,
      "ffi": true,
      "import": true
    },
    "include": [
      "tests/**/*test.ts"
    ],
    "exclude": [
      "src/**/*.{ts,tsx}"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "trailingCommas": "always",
    "json.trailingCommas": "never",
    "operatorPosition": "maintain",
    "jsx.bracketPosition": "sameLine",
    "jsx.forceNewLinesSurroundingContent": true,
    "jsx.multiLineParens": "always",
    "newLineKind": "lf",
    "include": [
      "src/**/*.{ts,tsx,js}",
      "tests/**/*test.ts"
    ]
  },
  "exclude": [
    "docs",
    "dist"
  ]
}
