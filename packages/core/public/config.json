{
  "$schema": "https://vanaware.github.io/linklist/config.schema.json",
  "version": "2",
  "profile": {
    "name": "Jane Doe",
    "tagline": "Developer & writer",
    "bio": "I build privacy-first tools for the open web.",
    "avatar": "./assets/avatar.svg",
    "avatar_alt": "Portrait of Jane Doe",
    "location": "Lisbon, PT",
    "title": "Jane Doe — links",
    "description": "All of Jane Doe's links in one fast, private page.",
    "image": "./assets/og.png",
    "url": "https://janedoe.github.io",
    "twitter": "@janedoe",
    "lang": "en"
  },
  "blocks": [
    {
      "format": "button",
      "title": "GitHub",
      "url": "https://github.com/janedoe",
      "icon": "github",
      "subtitle": "Source & projects",
      "new_tab": true
    },
    {
      "format": "card",
      "title": "Blog",
      "url": "https://janedoe.dev",
      "image": "./assets/cover.svg",
      "image_alt": "Illustration of a quill and terminal window"
    },
    {
      "format": "text",
      "title": "About",
      "body": "I write about **privacy-first** tooling and the open web.\n\n- Deno & Preact\n- Accessibility"
    },
    {
      "format": "card_text",
      "title": "Pinned note",
      "body": "Framed with the same bordered, softly-elevated surface an island gets — via `format: \"card_text\"`."
    },
    {
      "format": "island",
      "island": "Counter",
      "params": { "start": 3, "step": 2, "label": "Try an island" }
    },
    {
      "format": "island",
      "island": "Counter",
      "params": { "start": 100, "step": 10, "label": "Same island, separate state" }
    },
    {
      "format": "island",
      "island": "DemoWidget",
      "params": { "title": "Two-way reactivity" }
    },
    {
      "format": "row",
      "title": "Mastodon",
      "url": "https://mastodon.social/@janedoe",
      "icon": "mastodon",
      "new_tab": true,
      "nofollow": true
    },
    {
      "format": "card_figure",
      "image": "./assets/cover.svg",
      "image_alt": "Illustration of a quill and terminal window",
      "caption": "Latest post: privacy-first tooling"
    }
  ],
  "theme": {
    "preset": "violet",
    "mode": "auto",
    "custom": {
      "primary_color": "#a78bfa"
    }
  },
  "footer": {
    "show_last_updated": true,
    "updated": "2026-10-18"
  }
}
