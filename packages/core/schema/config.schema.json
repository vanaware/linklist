{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vanaware.github.io/linklist/config.schema.json",
  "title": "linklist config",
  "type": "object",
  "required": ["profile", "blocks", "theme"],
  "additionalProperties": false,
  "definitions": {
    "LinkBlock": {
      "description": "A single link/CTA. `format` chooses the row / button / card presentation.",
      "type": "object",
      "required": ["format", "title", "url"],
      "additionalProperties": false,
      "properties": {
        "format": { "enum": ["row", "button", "card"] },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "icon": { "type": "string" },
        "image": { "type": "string" },
        "image_alt": { "type": "string" },
        "subtitle": { "type": "string" },
        "new_tab": { "type": "boolean" },
        "nofollow": { "type": "boolean" }
      },
      "if": { "required": ["image"] },
      "then": { "required": ["image_alt"] }
    },
    "TextBlock": {
      "description": "A Markdown content block (`format: \"text\"`), optionally framed as a BeerCSS card (`format: \"card_text\"`).",
      "type": "object",
      "required": ["format"],
      "additionalProperties": false,
      "properties": {
        "format": { "enum": ["text", "card_text"] },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "markdown": { "type": "string" }
      },
      "anyOf": [{ "required": ["body"] }, { "required": ["markdown"] }]
    },
    "FigureBlock": {
      "description": "A standalone image/figure (`format: \"figure\"`), optionally framed as a BeerCSS card (`format: \"card_figure\"`).",
      "type": "object",
      "required": ["format", "image", "image_alt"],
      "additionalProperties": false,
      "properties": {
        "format": { "enum": ["figure", "card_figure"] },
        "image": { "type": "string" },
        "image_alt": { "type": "string", "minLength": 1 },
        "caption": { "type": "string" }
      }
    },
    "IslandBlock": {
      "description": "An interactive island hydrated from ./islands/<island>.js at runtime (`format: \"island\"`).",
      "type": "object",
      "required": ["format", "island"],
      "additionalProperties": false,
      "properties": {
        "format": { "const": "island" },
        "island": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "params": { "type": "object" }
      }
    },
    "Block": {
      "description": "A pure block: it names one predefined `format` and carries that format's fields.",
      "oneOf": [
        { "$ref": "#/definitions/LinkBlock" },
        { "$ref": "#/definitions/TextBlock" },
        { "$ref": "#/definitions/FigureBlock" },
        { "$ref": "#/definitions/IslandBlock" }
      ]
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "profile": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string" },
        "bio": { "type": "string" },
        "avatar": { "type": "string" },
        "avatar_alt": { "type": "string" },
        "location": { "type": "string" },
        "hide": {
          "type": "array",
          "items": { "enum": ["tagline", "bio", "avatar", "location"] }
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "twitter": { "type": "string" },
        "lang": { "type": "string" },
        "favicon": { "type": "string" }
      },
      "if": { "required": ["avatar"] },
      "then": { "required": ["avatar_alt"] }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/Block" },
      "contains": {
        "properties": {
          "format": { "enum": ["row", "button", "card"] }
        },
        "required": ["format"]
      },
      "minContains": 1
    },
    "theme": {
      "type": "object",
      "required": ["preset"],
      "additionalProperties": false,
      "properties": {
        "preset": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["light", "dark", "auto"] },
        "custom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary_color": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3,8})$"
            },
            "font_family": { "type": "string", "pattern": "^[^<>{};\"]*$" }
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show_last_updated": { "type": "boolean" },
        "updated": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Content last-updated date (YYYY-MM-DD); not the package/build date."
        },
        "label": { "type": "string" }
      }
    }
  }
}
