{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vanaware.github.io/linklist/config.schema.json",
  "title": "linklist config",
  "type": "object",
  "required": ["profile", "links", "theme"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "profile": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string" },
        "bio": { "type": "string" },
        "avatar": { "type": "string" },
        "avatar_alt": { "type": "string" },
        "location": { "type": "string" }
      },
      "if": { "required": ["avatar"] },
      "then": { "required": ["avatar_alt"] }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "icon": { "type": "string" },
          "subtitle": { "type": "string" },
          "button": { "type": "boolean" },
          "new_tab": { "type": "boolean" },
          "featured": { "type": "boolean" },
          "nofollow": { "type": "boolean" }
        }
      }
    },
    "theme": {
      "type": "object",
      "required": ["preset"],
      "additionalProperties": false,
      "properties": {
        "preset": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["light", "dark", "auto"] },
        "custom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary_color": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3,8})$"
            },
            "background_color": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3,8})$"
            },
            "text_color": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3,8})$"
            },
            "font_family": { "type": "string", "pattern": "^[^<>{};\"]*$" },
            "radius": { "type": "string", "pattern": "^[^<>{};\"]*$" },
            "shadow": { "enum": ["none", "small", "medium", "large"] }
          }
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "twitter": { "type": "string" },
        "lang": { "type": "string" },
        "favicon": { "type": "string" }
      }
    },
    "analytics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["none", "plausible", "umami", "google"] },
        "plausible_domain": { "type": "string" },
        "umami_website_id": { "type": "string" },
        "google_analytics_id": { "type": "string" },
        "click_counter_endpoint": { "type": "string", "format": "uri" }
      }
    },
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github_repos": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[^/]+/[^/]+$" }
        },
        "youtube_channel": { "type": "string" },
        "rss_feed": { "type": "string", "format": "uri" },
        "rss_limit": { "type": "integer", "minimum": 1, "maximum": 20 },
        "show_last_updated": { "type": "boolean" },
        "footer_label": { "type": "string" }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "body": { "type": "string" },
          "placement": { "enum": ["before", "after"] }
        }
      }
    }
  }
}
